# Copy this file to server/.env and fill in the values. Never commit server/.env.
PORT=5002
# Browser origins allowed to call the server (comma-separated). Your Vercel URL in production.
CLIENT_URL=http://localhost:5174
# MongoDB Atlas connection string, ending in /live-contest (the database name)
MONGODB_URI=
# Any long random string, used to sign host login tokens
JWT_SECRET=
# Google AI Studio key
GEMINI_API_KEY=
# Models to try, in order (first = preferred)
GEMINI_MODEL=gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite
GEMINI_THINKING_LEVEL=low
GEMINI_TIMEOUT_MS=30000
# Code runner. The public Judge0 CE instance needs no key.
JUDGE0_URL=https://ce.judge0.com
# Only for a Judge0 instance that needs a token
JUDGE0_KEY=
JUDGE_CONCURRENCY=3
